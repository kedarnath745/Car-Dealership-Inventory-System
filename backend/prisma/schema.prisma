// Prisma schema: the single source of truth for the database structure.
// Change it, then run `npm run db:migrate` to create a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  name         String
  /// Always stored lowercase so lookups are case-insensitive.
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Category {
  SEDAN
  SUV
  TRUCK
  COUPE
  HATCHBACK
  CONVERTIBLE
  VAN
  ELECTRIC
}

model Vehicle {
  id        String   @id @default(uuid())
  make      String
  model     String
  category  Category
  /// Money is stored as an exact decimal, never a float.
  price     Decimal  @db.Decimal(12, 2)
  /// Units in stock. A CHECK constraint in the migration keeps it >= 0.
  quantity  Int      @default(0)
  year      Int
  color     String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([price])
}
