# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://dealership:dealership@localhost:5432/dealership

# Auth: use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Seeded admin account (see prisma/seed.ts)
ADMIN_EMAIL=admin@dealership.com
ADMIN_PASSWORD=Admin@12345
