# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://dealership:dealership@localhost:5432/dealership

# Auth: use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Seeded admin account (see prisma/seed.ts)
ADMIN_EMAIL=admin@dealership.com
# At least 15 characters (NIST SP 800-63B-4, decision D23)
ADMIN_PASSWORD=showroom-admin-2026

# Brute-force protection on login/register (failed attempts per IP per window)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Reverse proxies in front of the API (0 locally, 1 on Render/Heroku)
TRUST_PROXY=0
